<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Myra.App.Views.ConfirmDialog"
        Title="Myra" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" x:Name="CancelButton" IsCancel="True" />
      <Button Content="OK" x:Name="OkButton" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
