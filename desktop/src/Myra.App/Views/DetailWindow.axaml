<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Myra.App.ViewModels"
        xmlns:views="using:Myra.App.Views"
        x:Class="Myra.App.Views.DetailWindow"
        x:DataType="vm:DetailViewModel"
        Title="{Binding DisplayName}"
        Icon="/Assets/Myra.ico"
        Width="820" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <views:DetailView x:Name="Details" />
</Window>
