<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Myra.App.ViewModels"
        xmlns:views="using:Myra.App.Views"
        x:Class="Myra.App.Views.PlayerWindow"
        x:DataType="vm:PlayerViewModel"
        Title="{Binding Title}"
        Icon="/Assets/Myra.ico"
        Width="1100" Height="700" MinWidth="640" MinHeight="400"
        Background="Black">
  <!-- Thin host: all player UI lives in PlayerView so the main window can embed the same control. -->
  <views:PlayerView x:Name="Player" />
</Window>
