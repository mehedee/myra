<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Myra.App.ViewModels"
             xmlns:views="using:Myra.App.Views"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="Myra.App.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True">
  <UserControl.Resources>
    <StreamGeometry x:Key="IconBack">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</StreamGeometry>
    <StreamGeometry x:Key="IconMute">M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z</StreamGeometry>
    <StreamGeometry x:Key="IconFullscreenExit">M14,14H19V16H16V19H14V14M5,14H10V19H8V16H5V14M8,5H10V10H5V8H8V5M19,8V10H14V5H16V8H19Z</StreamGeometry>
    <StreamGeometry x:Key="IconAudio">M12,3V13.55C11.41,13.21 10.73,13 10,13C7.79,13 6,14.79 6,17C6,19.21 7.79,21 10,21C12.21,21 14,19.21 14,17V7H18V3H12Z</StreamGeometry>
    <StreamGeometry x:Key="IconVideo">M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconList">M7,5H21V7H7V5M7,11H21V13H7V11M7,17H21V19H7V17M4,4.5A1.5,1.5 0 0,1 5.5,6A1.5,1.5 0 0,1 4,7.5A1.5,1.5 0 0,1 2.5,6A1.5,1.5 0 0,1 4,4.5M4,10.5A1.5,1.5 0 0,1 5.5,12A1.5,1.5 0 0,1 4,13.5A1.5,1.5 0 0,1 2.5,12A1.5,1.5 0 0,1 4,10.5M4,16.5A1.5,1.5 0 0,1 5.5,18A1.5,1.5 0 0,1 4,19.5A1.5,1.5 0 0,1 2.5,18A1.5,1.5 0 0,1 4,16.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlaylist">M19,9H2V11H19V9M19,5H2V7H19V5M2,15H15V13H2V15M17,13V19L22,16L17,13Z</StreamGeometry>
    <StreamGeometry x:Key="IconScissors">M19,3L13,9L15,11L22,4V3M12,12.5A0.5,0.5 0 0,1 11.5,12A0.5,0.5 0 0,1 12,11.5A0.5,0.5 0 0,1 12.5,12A0.5,0.5 0 0,1 12,12.5M6,20A2,2 0 0,1 4,18C4,16.89 4.9,16 6,16A2,2 0 0,1 8,18C8,19.11 7.1,20 6,20M6,8A2,2 0 0,1 4,6C4,4.89 4.9,4 6,4A2,2 0 0,1 8,6C8,7.11 7.1,8 6,8M9.64,7.64C9.87,7.14 10,6.59 10,6A4,4 0 0,0 6,2A4,4 0 0,0 2,6A4,4 0 0,0 6,10C6.59,10 7.14,9.87 7.64,9.64L10,12L7.64,14.36C7.14,14.13 6.59,14 6,14A4,4 0 0,0 2,18A4,4 0 0,0 6,22A4,4 0 0,0 10,18C10,17.41 9.87,16.86 9.64,16.36L12,14L19,21H22V20L9.64,7.64Z</StreamGeometry>
  </UserControl.Resources>

  <ThemeVariantScope RequestedThemeVariant="Dark">
  <Grid Background="Black">
    <DockPanel>
      <!-- Not fullscreen: header and controls sit around the video. Fullscreen: PlayerView moves them into the overlay. -->
      <ContentControl x:Name="TopSlot" DockPanel.Dock="Top">
        <ThemeVariantScope RequestedThemeVariant="Dark">
        <Border x:Name="Header" Background="#F0181818" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="12">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Button x:Name="BackButton" Command="{Binding BackToLibraryCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Back to Library" AutomationProperties.Name="Back to Library">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14" />
                <TextBlock Text="Back to Library" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding HeaderTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="White" />
              <TextBlock Text="{Binding FileName}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" Foreground="White"
                         ToolTip.Tip="{Binding FileName}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Foreground="White" />
            <Button Grid.Column="3" x:Name="FullscreenButton" Classes="icon" Command="{Binding ToggleFullscreenCommand}"
                    ToolTip.Tip="Enter fullscreen (F or F11)" AutomationProperties.Name="Fullscreen">
              <Panel>
                <PathIcon Data="{StaticResource IconFullscreen}" IsVisible="{Binding !IsFullscreen}" />
                <PathIcon Data="{StaticResource IconFullscreenExit}" IsVisible="{Binding IsFullscreen}" />
              </Panel>
            </Button>
          </Grid>
        </Border>
        </ThemeVariantScope>
      </ContentControl>

      <ContentControl x:Name="BottomSlot" DockPanel.Dock="Bottom">
        <ThemeVariantScope RequestedThemeVariant="Dark">
        <Border x:Name="Controls" Background="#F0181818" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="14,8">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding TimeText}" MinWidth="60" TextAlignment="Right" Foreground="White" VerticalAlignment="Center" FontFeatures="tnum" />
              <views:PlayerSeekBar Grid.Column="1" x:Name="SeekBar" Height="22" Value="{Binding PositionFraction}"
                                   Duration="{Binding Duration}" IsEnabled="{Binding IsSeekable}"
                                   AutomationProperties.Name="Video playback position" />
              <Button Grid.Column="2" Command="{Binding ToggleRemainingCommand}" Background="Transparent" Padding="4,2"
                      ToolTip.Tip="Toggle duration / remaining time" AutomationProperties.Name="Toggle duration / remaining time">
                <TextBlock Text="{Binding EndText}" MinWidth="60" Foreground="White" FontFeatures="tnum" />
              </Button>
            </Grid>
            <!-- Wide: one row (options left, transport centre, volume right). Narrow: three centred rows. See ArrangeControls. -->
            <Grid x:Name="ControlRow" ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <StackPanel x:Name="OptionsGroup" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="AudioMenuButton" Classes="icon" ToolTip.Tip="Audio" AutomationProperties.Name="Audio">
                  <PathIcon Data="{StaticResource IconAudio}" />
                </Button>
                <Button x:Name="SubtitleMenuButton" Classes="icon" ToolTip.Tip="Subtitles" AutomationProperties.Name="Subtitles">
                  <PathIcon Data="{StaticResource IconSubtitles}" />
                </Button>
                <Button x:Name="SpeedMenuButton" Classes="icon" ToolTip.Tip="Speed" AutomationProperties.Name="Speed">
                  <TextBlock Text="{Binding SpeedText}" MinWidth="30" TextAlignment="Center" FontFeatures="tnum" />
                </Button>
                <Button x:Name="VideoMenuButton" Classes="icon" ToolTip.Tip="Video" AutomationProperties.Name="Video">
                  <PathIcon Data="{StaticResource IconVideo}" />
                </Button>
                <Button x:Name="ChapterMenuButton" Classes="icon" ToolTip.Tip="Chapters" AutomationProperties.Name="Chapters"
                        IsVisible="{Binding HasChapters}">
                  <PathIcon Data="{StaticResource IconList}" />
                </Button>
                <ToggleButton Classes="icon" IsChecked="{Binding Repeat}" ToolTip.Tip="Repeat this video" AutomationProperties.Name="Repeat this video">
                  <PathIcon Data="{StaticResource IconRepeat}" />
                </ToggleButton>
                <ToggleButton Classes="icon" IsChecked="{Binding Autoplay}" IsVisible="{Binding ShowAutoplayToggle}"
                              ToolTip.Tip="Play the next video when this one ends" AutomationProperties.Name="Autoplay">
                  <PathIcon Data="{StaticResource IconAutoNext}" />
                </ToggleButton>
                <Button Classes="icon" Command="{Binding OpenQueueCommand}" IsVisible="{Binding HasEpisodeQueue}"
                        ToolTip.Tip="Episodes / Files" AutomationProperties.Name="Episodes / Files">
                  <PathIcon Data="{StaticResource IconPlaylist}" />
                </Button>
                <Button Classes="icon" Command="{Binding OpenPreferencesCommand}" IsVisible="{Binding HasPlaybackPreferences}"
                        ToolTip.Tip="Playback preferences" AutomationProperties.Name="Playback preferences">
                  <PathIcon Data="{StaticResource IconSettings}" />
                </Button>
                <Button Classes="icon" Command="{Binding EditMarkersCommand}" IsVisible="{Binding HasSkipMarkers}" IsEnabled="{Binding IsSeekable}"
                        ToolTip.Tip="Intro / outro markers" AutomationProperties.Name="Intro / outro markers">
                  <PathIcon Data="{StaticResource IconScissors}" />
                </Button>
              </StackPanel>

              <StackPanel x:Name="TransportGroup" Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Classes="icon" ToolTip.Tip="Previous video (P)" AutomationProperties.Name="Previous video" Command="{Binding PreviousCommand}">
                  <PathIcon Data="{StaticResource IconPrevious}" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="Back 10 seconds (Left)" AutomationProperties.Name="Back 10 seconds"
                        Command="{Binding JumpCommand}" CommandParameter="-10" IsEnabled="{Binding IsSeekable}">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <PathIcon Data="{StaticResource IconRewind}" />
                    <TextBlock Text="10" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="icon accent" ToolTip.Tip="Play / Pause (Space)" AutomationProperties.Name="Play or pause"
                        Command="{Binding PlayPauseCommand}" MinWidth="44">
                  <Panel>
                    <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}" />
                    <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}" />
                  </Panel>
                </Button>
                <Button Classes="icon" ToolTip.Tip="Stop" AutomationProperties.Name="Stop" Command="{Binding StopCommand}">
                  <PathIcon Data="{StaticResource IconStop}" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="Forward 10 seconds (Right)" AutomationProperties.Name="Forward 10 seconds"
                        Command="{Binding JumpCommand}" CommandParameter="10" IsEnabled="{Binding IsSeekable}">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="10" FontSize="10" VerticalAlignment="Center" />
                    <PathIcon Data="{StaticResource IconForward}" />
                  </StackPanel>
                </Button>
                <Button Classes="icon" ToolTip.Tip="Next video (N)" AutomationProperties.Name="Next video" Command="{Binding NextCommand}">
                  <PathIcon Data="{StaticResource IconNext}" />
                </Button>
              </StackPanel>

              <StackPanel x:Name="VolumeGroup" Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="icon" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)" AutomationProperties.Name="Mute">
                  <Panel>
                    <PathIcon Data="{StaticResource IconVolume}" IsVisible="{Binding IsAudible}" />
                    <PathIcon Data="{StaticResource IconMute}" IsVisible="{Binding IsMuted}" />
                  </Panel>
                </Button>
                <Slider Width="100" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center"
                        ToolTip.Tip="Volume (Up / Down)" AutomationProperties.Name="Volume" />
                <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Width="38" FontSize="12" Foreground="White" VerticalAlignment="Center" FontFeatures="tnum" />
              </StackPanel>
            </Grid>
            <TextBlock Text="This source does not support seeking." FontSize="12" Opacity="0.65" Foreground="White" HorizontalAlignment="Center"
                       IsVisible="{Binding SeekingUnsupported}" />
          </StackPanel>
        </Border>
        </ThemeVariantScope>
      </ContentControl>

      <!-- The video surface is native, so everything drawn over it lives in Content, which libVLCSharp shows in an overlay. -->
      <vlc:VideoView x:Name="Video">
        <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid x:Name="OverlayRoot" Background="#01000000">
          <Grid x:Name="FullscreenChrome" RowDefinitions="Auto,*,Auto" IsVisible="False">
            <ContentControl x:Name="OverlayTop" />
            <ContentControl x:Name="OverlayBottom" Grid.Row="2" />
          </Grid>

          <Border Background="#BF000000" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding HasError}">
            <StackPanel Spacing="12" MaxWidth="440">
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="White" />
              <Button Content="Try another version" Command="{Binding TryAnotherVersionCommand}" HorizontalAlignment="Center"
                      IsVisible="{Binding CanTryAnotherVersion}" />
            </StackPanel>
          </Border>

          <Border Background="#E6202020" CornerRadius="10" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding ShowBuffering}" IsHitTestVisible="False">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="120" />
              <TextBlock Text="Buffering…" Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <Button Content="{Binding ActiveSkip.Label}" Command="{Binding SkipCommand}" IsVisible="{Binding ShowSkip}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,16,16,110" />

          <Border Background="#E6202020" CornerRadius="10" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="16,72,16,16" IsVisible="{Binding ShowResumePrompt}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding ResumePromptText}" Foreground="White" VerticalAlignment="Center" />
              <Button Content="Resume" Command="{Binding ResumeSavedPositionCommand}" />
              <Button Content="Start Over" Command="{Binding StartOverCommand}" />
            </StackPanel>
          </Border>
        </Grid>
        </ThemeVariantScope>
      </vlc:VideoView>
    </DockPanel>
  </Grid>
  </ThemeVariantScope>
</UserControl>
