<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Myra.App.ViewModels"
             xmlns:views="using:Myra.App.Views"
             x:Class="Myra.App.Views.QueuePanel"
             x:DataType="vm:QueueViewModel">
  <!-- Episodes / Files panel. It sits beside the video: native video surfaces cannot be overlaid. -->
  <DockPanel Margin="14">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Heading}" Classes="title" FontSize="18" />
        <TextBlock Text="{Binding Subheading}" Classes="caption" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1" Classes="icon plain" Command="{Binding CloseCommand}" ToolTip.Tip="Close" VerticalAlignment="Top">
        <PathIcon Data="{StaticResource IconClose}" />
      </Button>
    </Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Panel IsVisible="{Binding HasEpisodes}">
          <views:DetailEpisodeList DataContext="{Binding Episodes}" />
        </Panel>
        <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QueueFileRow">
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding PlayCommand}" Margin="0,0,0,4"
                      ToolTip.Tip="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" IsVisible="{Binding IsCurrent}"
                            Foreground="{DynamicResource SystemAccentColor}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Quality}" Classes="caption" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
