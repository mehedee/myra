<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Myra.App.ViewModels"
        xmlns:views="using:Myra.App.Views"
        x:Class="Myra.App.Views.DetailChooserWindow"
        x:DataType="vm:DetailChooserViewModel"
        Title="{Binding Heading}"
        Icon="/Assets/Myra.ico"
        Width="750" Height="520" MinWidth="640" MinHeight="340"
        WindowStartupLocation="CenterOwner">
  <!-- macOS EntertainmentVersionChooser. -->
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Heading}" Classes="title" />
        <TextBlock Text="{Binding DisplayName}" Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1" Content="Cancel" x:Name="CancelButton" VerticalAlignment="Top" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="caption" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="Availability is based on your index. Quality labels come from filenames; unknown properties are shown explicitly." />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <views:DetailEpisodeList DataContext="{Binding Episodes}" />
    </ScrollViewer>
  </DockPanel>
</Window>
